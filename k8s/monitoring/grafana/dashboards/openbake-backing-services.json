    {
      "id": 161,
      "type": "timeseries",
      "title": "Redis 메모리 사용률",
      "description": "maxmemory 128mb + noeviction 조합이라 한계에 닿으면 오래된 키를 지우는 것이 아니라 쓰기가 실패한다. 드롭 재고 선점과 Refresh Token이 동시에 깨지므로 도달하기 전에 대응해야 한다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (redis_memory_used_bytes / redis_memory_max_bytes)",
          "legendFormat": "사용률",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "dashed"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
