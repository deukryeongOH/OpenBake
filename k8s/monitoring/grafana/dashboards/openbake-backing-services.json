    {
      "id": 141,
      "type": "timeseries",
      "title": "회로 차단기 상태 (OPEN=1)",
      "description": "elasticsearch·ai-semantic-search 회로가 열리면 해당 의존성을 끊고 폴백으로 넘어간 것이다. 열렸다는 사실만 알려줄 뿐 왜 느린지는 알려주지 않으므로, 원인은 해당 서비스에서 확인한다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (name) (resilience4j_circuitbreaker_state{state=\"open\"})",
          "legendFormat": "{{name}} OPEN",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (name) (resilience4j_circuitbreaker_state{state=\"half_open\"})",
          "legendFormat": "{{name}} HALF_OPEN",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
