    {
      "type": "stat",
      "title": "클러스터 상태",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(max(elasticsearch_cluster_health_status{color=\"red\"} == 1) * 2) or (max(elasticsearch_cluster_health_status{color=\"yellow\"} == 1) * 1) or (max(elasticsearch_cluster_health_status{color=\"green\"} == 1) * 0)",
          "legendFormat": "상태",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "정상 (green)",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "주의 (yellow)",
                  "color": "yellow",
                  "index": 1
                },
                "2": {
                  "text": "위험 (red)",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto"
      },
      "description": "green=복제본까지 정상, yellow=주 샤드는 살아있고 복제본이 없음, red=주 샤드 유실. 노드가 1대면 복제본을 둘 곳이 없어 yellow가 정상 상태다. 다만 이 노드가 죽으면 검색 데이터는 사라진다."
    },
