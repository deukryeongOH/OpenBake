  "version": 1,
  "weekStart": "",
  "panels": [
    {
      "id": 101,
      "type": "timeseries",
      "title": "Node 디스크 사용률",
      "description": "09번 문서 5장 기준: 70% 경고 · 80% 위험 · 90% 비상. 두 Node의 PVC가 물리적으로 같은 디스크를 쓰므로 하나가 차면 그 Node의 DB·kubelet까지 함께 영향을 받는다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"})",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "dashed"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 102,
      "type": "timeseries",
      "title": "Node 메모리 사용률",
      "description": "Node A 8GB / Node B 4GB. HPA가 replica를 늘릴 여유가 남아 있는지 본다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 103,
      "type": "timeseries",
      "title": "Node CPU 사용률",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (1 - avg by (node) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 104,
      "type": "timeseries",
      "title": "컨테이너 CPU 사용량",
      "description": "cAdvisor 실측값. kube-state-metrics의 재시작 횟수와 달리 '지금 얼마나 쓰는가'를 보여준다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(\n  sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"openbake\"}[5m])),\n  \"pod\", \"$1-$2\", \"pod\", \"^(.+?)-[a-z0-9]*[0-9][a-z0-9]*-([a-z0-9]{5})$\"\n)",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "hidden",
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 105,
      "type": "timeseries",
      "title": "컨테이너 메모리 (working set)",
      "description": "limit에 근접하면 OOMKilled로 이어진다. 아래 재시작 패널과 함께 본다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(\n  sum by (pod) (container_memory_working_set_bytes{namespace=\"openbake\"}),\n  \"pod\", \"$1-$2\", \"pod\", \"^(.+?)-[a-z0-9]*[0-9][a-z0-9]*-([a-z0-9]{5})$\"\n)",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "hidden",
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 106,
      "type": "timeseries",
      "title": "Pod 재시작 (15분)",
      "description": "프로세스가 살아나도 업무는 복구되지 않았을 수 있다. 재시작 뒤에는 아래 업무 적체를 반드시 확인한다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(\n  sum by (namespace, pod) (increase(kube_pod_container_status_restarts_total{namespace=~\"openbake|monitoring\"}[15m])),\n  \"pod\", \"$1-$2\", \"pod\", \"^(.+?)-[a-z0-9]*[0-9][a-z0-9]*-([a-z0-9]{5})$\"\n)",
          "legendFormat": "{{namespace}}/{{pod}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 107,
      "type": "timeseries",
      "title": "OOMKilled 발생",
      "description": "메모리 한도 초과로 강제 종료된 컨테이너.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(\n  sum by (namespace, pod, container) (kube_pod_container_status_last_terminated_reason{reason=\"OOMKilled\"}),\n  \"pod\", \"$1-$2\", \"pod\", \"^(.+?)-[a-z0-9]*[0-9][a-z0-9]*-([a-z0-9]{5})$\"\n)",
          "legendFormat": "{{namespace}}/{{pod}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "vector(0)",
          "legendFormat": "없음 (정상)",
          "range": true,
          "refId": "Z"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 108,
      "type": "timeseries",
      "title": "컨테이너 CPU throttling",
      "description": "CPU limit에 걸려 대기한 시간. 값이 크면 limit이 응답 지연의 원인이다.",
