# Spring Boot Actuator /actuator/prometheus 대상
# Prometheus가 Docker 안에서 실행되므로 host.docker.internal을 사용합니다.
OPENBAKE_CORE_TARGET=host.docker.internal:8080
OPENBAKE_MEMBER_TARGET=host.docker.internal:8081
OPENBAKE_PAYMENT_TARGET=host.docker.internal:8082

# Grafana 로컬 관리자 계정
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=openbake
