# =========================
# OpenBake monitoring target
# =========================
# WSL2 + Docker Desktop에서 auto를 사용하면 run-monitoring.sh가
# hostname -I로 WSL IP를 찾아 Prometheus target을 자동 구성합니다.
# Linux/macOS 등 일반 환경에서는 host.docker.internal을 기본값으로 사용합니다.
OPENBAKE_TARGET_HOST=auto

OPENBAKE_CORE_PORT=8080
OPENBAKE_MEMBER_PORT=8081
OPENBAKE_PAYMENT_PORT=8082

# 필요하면 아래 값을 직접 지정하여 자동 계산을 덮어쓸 수 있습니다.
# 예: OPENBAKE_CORE_TARGET=10.0.0.10:8080
OPENBAKE_CORE_TARGET=
OPENBAKE_MEMBER_TARGET=
OPENBAKE_PAYMENT_TARGET=

# Prometheus 검증 시 반드시 UP이어야 하는 job.
# 현재 Drop 성능 테스트의 핵심 대상은 Core입니다.
REQUIRED_PROMETHEUS_JOBS=openbake-core

# Grafana 로컬 관리자 계정
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Phase 5 custom Drop lock metric을 필수로 검증할지 여부.
# instrumentation/lock 패치를 적용하고 앱을 재시작한 뒤 true로 변경하세요.
REQUIRE_LOCK_METRICS=false
