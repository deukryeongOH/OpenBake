# =========================
# OpenBake Monitoring
# =========================
#
# MONITORING_PROFILE
#   auto   : 실행 환경 자동 감지 (권장)
#            - localhost:8080에 Core가 있으면 local
#            - 그렇지 않고 openbake-backend 컨테이너가 실행 중이면 server
#   local  : WSL/호스트에서 bootRun 중인 서비스 scrape
#   server : Docker 컨테이너를 같은 Docker network에서 직접 scrape
MONITORING_PROFILE=auto

# -------------------------
# local
# -------------------------
# WSL2 + Docker Desktop에서는 auto가 WSL IPv4 주소를 자동 탐지합니다.
# 일반 Linux/macOS 로컬 환경에서는 host.docker.internal을 기본값으로 사용합니다.
OPENBAKE_TARGET_HOST=auto

OPENBAKE_CORE_PORT=8080
OPENBAKE_MEMBER_PORT=8081
OPENBAKE_PAYMENT_PORT=8082
# ai-service는 선택 대상입니다. 실행 중이 아니어도 모니터링 기동은 정상 진행됩니다.
OPENBAKE_AI_PORT=8083

# 필요할 때만 직접 지정합니다.
# 비워두면 위 host/port 조합을 사용합니다.
LOCAL_CORE_TARGET=
LOCAL_MEMBER_TARGET=
LOCAL_PAYMENT_TARGET=
LOCAL_AI_TARGET=

# -------------------------
# server
# -------------------------
CORE_CONTAINER=openbake-backend
MEMBER_CONTAINER=openbake-member-service
PAYMENT_CONTAINER=openbake-payment
AI_CONTAINER=openbake-ai-service
PROM_CONTAINER=openbake-prometheus

# 서버에서는 컨테이너 이름으로 직접 scrape합니다.
SERVER_CORE_TARGET=openbake-backend:8080
SERVER_MEMBER_TARGET=openbake-member-service:8081
SERVER_PAYMENT_TARGET=openbake-payment:8082
SERVER_AI_TARGET=openbake-ai-service:8083

# -------------------------
# verification
# -------------------------
REQUIRED_PROMETHEUS_JOBS=openbake-core,openbake-member,openbake-payment
#REQUIRED_PROMETHEUS_JOBS=openbake-core

# -------------------------
# Grafana
# -------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=openbake
