# =========================
# OpenBake k6 공통 설정
# =========================

# =========================
# OpenBake 서비스 주소
# =========================

CORE_BASE_URL=http://localhost:8080
MEMBER_BASE_URL=http://localhost:8081
PAYMENT_BASE_URL=http://localhost:8082

# =========================
# Drop 성능 테스트
# =========================
# 테스트 대상 Drop
DROP_ID=1

# 단계별로 5 -> 20 -> 50 -> 100 권장
USER_COUNT=5
#START_INDEX=6

# lock-start 요청 수량
QUANTITY=1

# =========================
# 재고 선점 테스트 기대값
# =========================

# 재고가 충분한 기본 시나리오:
# EXPECTED_SUCCESS=100
# EXPECTED_SOLD_OUT=0
#
# 예: 재고 3개 / 사용자 5명:
# EXPECTED_SUCCESS=3
# EXPECTED_SOLD_OUT=2

EXPECTED_SUCCESS=5
EXPECTED_SOLD_OUT=0

# =========================
# Member 로그인
# =========================

# 프로젝트의 실제 로그인 API 경로로 수정
LOGIN_PATH=/api/v1/auth/login

# BCrypt hash가 아니라 실제 평문 테스트 비밀번호
TEST_PASSWORD=123456789

# 로그인 응답에서 Access Token이 있는 JSON 경로
#
# {"data":{"accessToken":"..."}} -> data.accessToken
# {"accessToken":"..."}          -> accessToken
TOKEN_PATH=data.accessToken

# 로그인 요청 JSON 필드명
EMAIL_FIELD=email
PASSWORD_FIELD=password

# 테스트 계정 규칙
EMAIL_PREFIX=loadtest
EMAIL_DOMAIN=naver.com
START_INDEX=1

# users.json 생성 위치
OUTPUT_FILE=users.json

# 로그인 요청 timeout (초)
REQUEST_TIMEOUT=10
