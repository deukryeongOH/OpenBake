# =========================
# OpenBake k6 공통 설정
# =========================

# 서비스 주소
CORE_BASE_URL=http://localhost:8088
MEMBER_BASE_URL=http://localhost:8088

# Drop 성능 테스트
DROP_ID=9
USER_COUNT=100
START_INDEX=1
QUANTITY=1

# =========================
# 타임아웃
# =========================
# HTTP_TIMEOUT: 요청 1건의 상한. 짧으면 k6가 먼저 끊어 status=0으로 기록되고
#               실제 응답시간을 알 수 없게 된다.
# MAX_DURATION: 시나리오 전체 상한. 반드시 HTTP_TIMEOUT보다 커야 한다.
# 주의: 게이트웨이 response-timeout(기본 10s)이 실질 천장이므로
#       그보다 크게 잡으려면 GATEWAY_RESPONSE_TIMEOUT도 같이 올려야 한다.
HTTP_TIMEOUT=30s
MAX_DURATION=120s

# wait-active는 반복 폴링이라 별도로 짧게 잡는다.
WAIT_ACTIVE_HTTP_TIMEOUT=10s

# 재고 선점 기대값


EXPECTED_SUCCESS=100
EXPECTED_SOLD_OUT=0

# Member 로그인
LOGIN_PATH=/api/v1/auth/login
TEST_PASSWORD=123456789
TOKEN_PATH=data.accessToken
EMAIL_FIELD=email
PASSWORD_FIELD=password
EMAIL_PREFIX=loadtest
EMAIL_DOMAIN=naver.com

# users.json 생성
# 현재 k6-users.js와 일치시키기 위해 users.json을 사용합니다.
OUTPUT_FILE=users.json
REQUEST_TIMEOUT=10

# =========================
# 결과 저장 / 요약 출력
# =========================
# 비우면 performance-test/results/runs 아래에 실행별 폴더가 생성됩니다.
# RESULTS_ROOT=/tmp/openbake-k6-results
K6_SUMMARY_TREND_STATS='avg,min,med,p(90),p(95),p(99),max'

# -----------------------------------------------------------------------------
# Phase 2 - k6 -> Prometheus Remote Write (optional)
# experimental-prometheus-rw output이므로 기본은 false입니다.
# -----------------------------------------------------------------------------
K6_PROMETHEUS_RW_ENABLED=true
K6_PROMETHEUS_RW_SERVER_URL=http://localhost:9090/api/v1/write
K6_PROMETHEUS_RW_TREND_STATS='p(95),p(99),min,max'
K6_PROMETHEUS_RW_PUSH_INTERVAL=1s


AUTH_MODE=gateway
