# k3s: api-gateway Service의 주소를 사용
# cutover(이슈 5) 전에는 Ingress가 없으므로 port-forward로 임시 접근한다.
#   kubectl -n openbake port-forward service/api-gateway 8088:8080
#   SERVER_BASE_URL=http://localhost:8088
# cutover 후에는 실제 외부 도메인을 쓴다.
SERVER_BASE_URL=http://localhost:8088

AUTH_MODE=gateway

# 중요:
# 이 자동화는 Drop을 즉시 ACTIVE로 만들고 생성된 dropId를 찾기 위해 kubectl exec로
# core-postgres Pod에 접속하고, TodayDropCache 갱신을 위해 backend Deployment를
# kubectl rollout restart한다. kubectl이 대상 클러스터를 가리키고 있어야 한다.
PERF_DB_ENABLED=true
PERF_EXEC_MODE=kubectl
PERF_K8S_NAMESPACE=openbake
PERF_DB_WORKLOAD=statefulset/core-postgres
PERF_BACKEND_WORKLOAD=deployment/backend
