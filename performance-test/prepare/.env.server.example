# 서버: Nginx/API Gateway 외부 주소 하나를 사용
# 예: https://api.example.com
# 예: http://52.x.x.x
SERVER_BASE_URL=http://3.38.24.67

AUTH_MODE=gateway

# 중요:
# 이 자동화는 Drop을 즉시 ACTIVE로 만들고 생성된 dropId를 찾기 위해 DB container를 사용합니다.
# 따라서 기본 server 모드는 "서버 머신에 SSH 접속한 상태에서 이 스크립트를 실행"하는 것을 전제로 합니다.
PERF_DB_ENABLED=true
PERF_DB_CONTAINER=openbake-postgres
PERF_BACKEND_CONTAINER=openbake-backend
